# Set these privately in Hostinger. Never commit real secrets.
NODE_ENV=production
APP_ORIGIN=https://hoe.dating
LAUNCH_AT=2026-12-25T00:00:00-08:00
# Choose an absolute persistent directory outside hbuilds/public_html:
# COUNTER_DATA_DIR=/absolute/persistent/hoe-data

# Create a Turnstile widget for hoe.dating, then add its keys:
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hostinger Mail API key and the mailbox identifier for connect@feyros.com:
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_ID=

# Maximum new internal signup notifications per UTC day; raise deliberately:
WAITLIST_DAILY_LIMIT=100
